{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker público: /privacy, /data-deletion, /terms, /health y /media/<clave>. Sin Access, sin crons.
  // Deploy: npx wrangler deploy -c wrangler.public.jsonc
  "name": "misocial-ia-public",
  "main": "src/public-worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "misocial-ia",
      "database_id": "f4e45585-f249-46d6-afed-2d7d565956a8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "misocial-ia-media" }],

  "vars": {
    "PUBLIC_BASE_URL": "https://misocial-ia-public.castilloconsultores.workers.dev"
  }

  // Secret: META_APP_SECRET (valida el signed_request de eliminación de datos de Meta, FASE 3).
}
